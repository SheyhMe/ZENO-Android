<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080B14"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="22dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="14dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Z E N O"
                android:textColor="#F4F7FF"
                android:textSize="25sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.18" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERSONAL AI SYSTEM"
                android:textColor="#78849F"
                android:textSize="9sp"
                android:letterSpacing="0.2" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#142A2C"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:text="● ONLINE"
            android:textColor="#64E6C2"
            android:textSize="10sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/homePage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="18dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Sizning raqamli yordamchingiz"
                    android:textColor="#F1F4FC"
                    android:textSize="21sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Gapiring. Buyruq bering. ZENO bajarsin."
                    android:textColor="#8792A8"
                    android:textSize="12sp" />
                <FrameLayout
                    android:id="@+id/orbContainer"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/zeno_orb">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="22dp"
                        android:text="ZENO CORE"
                        android:textColor="#C8C2FF"
                        android:textSize="10sp"
                        android:letterSpacing="0.24" />
                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:gravity="center"
                        android:padding="20dp"
                        android:text="ZENO tayyor"
                        android:textColor="#F1F2FF"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium" />
                </FrameLayout>
                <Button
                    android:id="@+id/listenButton"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#285B60"
                    android:text="Ovozli suhbat (ixtiyoriy)"
                    android:textAllCaps="false"
                    android:textColor="#F1FFFC"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:gravity="center"
                    android:text="Mikrofon faqat siz ruxsat berganingizda ishlaydi"
                    android:textColor="#65738B"
                    android:textSize="10sp" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/chatPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUHBATLAR"
                    android:textColor="#F1F4FC"
                    android:textSize="21sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/chatLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="260dp"
                    android:layout_marginTop="14dp"
                    android:padding="17dp"
                    android:background="@drawable/rounded_panel"
                    android:text="ZENO&#10;Salom. Sizga qanday yordam bera olaman?"
                    android:textColor="#E5EAF5"
                    android:textSize="14sp"
                    android:lineSpacingExtra="6dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <EditText
                        android:id="@+id/messageInput"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:hint="Xabar yoki buyruq yozing..."
                        android:singleLine="true"
                        android:paddingStart="16dp"
                        android:paddingEnd="12dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#78849A"
                        android:background="@drawable/rounded_input"
                        android:imeOptions="actionSend"
                        android:inputType="textCapSentences|textMultiLine" />
                    <Button
                        android:id="@+id/sendButton"
                        android:layout_width="58dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="8dp"
                        android:text="➤"
                        android:textSize="20sp"
                        android:backgroundTint="#625BE8"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/appsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ILOVALAR VA BUYRUQLAR"
                    android:textColor="#F1F4FC"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Tanlang — ZENO buyruqni suhbatga tayyorlaydi."
                    android:textColor="#8792A8"
                    android:textSize="12sp" />
                <Button android:id="@+id/appsButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="18dp" android:text="YouTube ochish" android:textAllCaps="false" android:backgroundTint="#182438" android:textColor="#D9E7FF" />
                <Button android:id="@+id/telegramButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="8dp" android:text="Telegram ochish" android:textAllCaps="false" android:backgroundTint="#182438" android:textColor="#D9E7FF" />
                <Button android:id="@+id/instagramButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="8dp" android:text="Instagram ochish" android:textAllCaps="false" android:backgroundTint="#182438" android:textColor="#D9E7FF" />
                <Button android:id="@+id/chromeButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="8dp" android:text="Chrome ochish" android:textAllCaps="false" android:backgroundTint="#182438" android:textColor="#D9E7FF" />
                <Button android:id="@+id/cameraButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="8dp" android:text="Kamera ochish" android:textAllCaps="false" android:backgroundTint="#182438" android:textColor="#D9E7FF" />
                <Button android:id="@+id/searchButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="8dp" android:text="Internetdan qidirish" android:textAllCaps="false" android:backgroundTint="#182438" android:textColor="#D9E7FF" />
                <Button android:id="@+id/alarmButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="8dp" android:text="Budilnik qo'yish" android:textAllCaps="false" android:backgroundTint="#182438" android:textColor="#D9E7FF" />
                <Button android:id="@+id/timerButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="8dp" android:text="Taymer qo'yish" android:textAllCaps="false" android:backgroundTint="#182438" android:textColor="#D9E7FF" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/profilePage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ZENO HAQIDA"
                    android:textColor="#F1F4FC"
                    android:textSize="21sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:padding="18dp"
                    android:background="#111827"
                    android:text="ZENO — Aslbekning shaxsiy AI yordamchisi. Loyiha egasi va yo'nalishini belgilagan inson — Aslbek (GitHub: SheyhMe). Android ilovasi ChatGPT yordamida ishlab chiqilmoqda, ovozli AI qismi ElevenLabs texnologiyasidan foydalanadi."
                    android:textColor="#E5EAF5"
                    android:textSize="14sp"
                    android:lineSpacingExtra="5dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="LOYIHA EGASI"
                    android:textColor="#A5B1C8"
                    android:textSize="11sp"
                    android:letterSpacing="0.16" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="18dp"
                    android:background="#111827"
                    android:text="Aslbek — Xorazmdan. Texnologiya, sun'iy intellekt, Android dasturlash, kiberxavfsizlik, dizayn va Mobile Legendsga qiziqadi. Amaliy natija, mustaqillik va qisqa, aniq muloqotni qadrlaydi."
                    android:textColor="#E5EAF5"
                    android:textSize="14sp"
                    android:lineSpacingExtra="5dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Shaxsiy ma'lumotlar himoyalangan. ZENO egasining maxfiy ma'lumotlarini o'z-o'zidan oshkor qilmaydi."
                    android:textColor="#78849F"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:background="@drawable/rounded_panel">
        <Button android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Bosh sahifa" android:textAllCaps="false" android:textSize="10sp" android:backgroundTint="#202C45" android:textColor="#E5EAF5" />
        <Button android:id="@+id/navChat" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Suhbat" android:textAllCaps="false" android:textSize="10sp" android:backgroundTint="#111827" android:textColor="#E5EAF5" />
        <Button android:id="@+id/navApps" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Ilovalar" android:textAllCaps="false" android:textSize="10sp" android:backgroundTint="#111827" android:textColor="#E5EAF5" />
        <Button android:id="@+id/navProfile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Profil" android:textAllCaps="false" android:textSize="10sp" android:backgroundTint="#111827" android:textColor="#E5EAF5" />
    </LinearLayout>
</LinearLayout>