<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/zeno_background"
    android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="12dp" android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="54dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="42dp" android:layout_height="42dp"
            android:gravity="center" android:background="@drawable/zeno_logo"
            android:text="Z" android:textColor="@color/zeno_text" android:textSize="25sp"
            android:fontFamily="sans-serif-black" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ZENO" android:textColor="@color/zeno_text" android:textSize="19sp"
                android:fontFamily="sans-serif-medium" android:letterSpacing="0.08"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="● ONLINE" android:textColor="@color/zeno_status" android:textSize="10sp"/>
        </LinearLayout>
        <TextView android:layout_width="38dp" android:layout_height="38dp"
            android:gravity="center" android:background="@drawable/zeno_surface"
            android:text="⚙" android:textColor="@color/zeno_accent_soft" android:textSize="19sp"/>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ScrollView android:id="@+id/homePage" android:layout_width="match_parent"
            android:layout_height="match_parent" android:fillViewport="true"
            android:overScrollMode="never">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal" android:paddingBottom="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:text="Hello, Albek janoblari."
                    android:textColor="@color/zeno_text" android:textSize="21sp" android:fontFamily="sans-serif-medium"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:text="Bugun sizga qanday yordam beray?"
                    android:textColor="@color/zeno_muted" android:textSize="13sp"/>
                <FrameLayout android:id="@+id/orbContainer" android:layout_width="match_parent"
                    android:layout_height="300dp" android:layout_marginTop="12dp"
                    android:background="@drawable/zeno_orb">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="center" android:text="Z" android:textColor="@color/zeno_text"
                        android:textSize="92sp" android:fontFamily="sans-serif-black"
                        android:shadowColor="#9B63FF" android:shadowRadius="28"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="25dp"
                        android:text="✦  ─  ▏▎▍▆█▆▍▎▏  ─  ✦" android:textColor="#A78BFA" android:textSize="17sp"/>
                </FrameLayout>
                <TextView android:id="@+id/statusText" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:gravity="center"
                    android:layout_marginTop="2dp" android:padding="8dp"
                    android:text="ZENO tayyor" android:textColor="@color/zeno_accent" android:textSize="12sp"/>
                <Button android:id="@+id/homeVoiceButton" android:layout_width="match_parent"
                    android:layout_height="52dp" android:layout_marginTop="8dp"
                    android:background="@drawable/zeno_primary_button" android:text="◉   Ovozli yordamchi"
                    android:textAllCaps="false" android:textColor="@color/zeno_text" android:textSize="14sp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="18dp">
                    <LinearLayout android:id="@+id/homeChatTile" android:clickable="true" android:focusable="true" android:layout_width="0dp" android:layout_height="88dp"
                        android:layout_weight="1" android:layout_marginEnd="6dp"
                        android:gravity="center" android:orientation="vertical" android:background="@drawable/zeno_surface">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="✧" android:textColor="@color/zeno_accent_soft" android:textSize="24sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="AI Chat" android:textColor="@color/zeno_text" android:textSize="12sp"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/homeAppsTile" android:clickable="true" android:focusable="true" android:layout_width="0dp" android:layout_height="88dp"
                        android:layout_weight="1" android:layout_marginStart="6dp"
                        android:gravity="center" android:orientation="vertical" android:background="@drawable/zeno_surface">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="▦" android:textColor="@color/zeno_accent_soft" android:textSize="24sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Quick Actions" android:textColor="@color/zeno_text" android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout android:id="@+id/chatPage" android:layout_width="match_parent"
            android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="AI Chat" android:textColor="@color/zeno_text" android:textSize="22sp"
                android:fontFamily="sans-serif-medium" android:paddingTop="8dp" android:paddingBottom="10dp"/>
            <ScrollView android:id="@+id/chatScroll" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"
                android:overScrollMode="never">
                <TextView android:id="@+id/chatLog" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="300dp"
                    android:padding="16dp" android:background="@drawable/zeno_surface"
                    android:text="ZENO&#10;Salom, Albek janoblari! Men sizga qanday yordam bera olaman?"
                    android:textColor="@color/zeno_text" android:textSize="14sp" android:lineSpacingExtra="7dp"/>
            </ScrollView>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal"
                android:layout_marginTop="10dp" android:layout_marginBottom="4dp">
                <EditText android:id="@+id/messageInput" android:layout_width="0dp"
                    android:layout_height="54dp" android:layout_weight="1"
                    android:hint="Xabar yozing..." android:singleLine="true"
                    android:paddingStart="16dp" android:paddingEnd="12dp"
                    android:textColor="@color/zeno_text" android:textColorHint="@color/zeno_muted"
                    android:background="@drawable/rounded_input" android:imeOptions="actionSend"
                    android:inputType="textCapSentences"/>
                <Button android:id="@+id/sendButton" android:layout_width="54dp"
                    android:layout_height="54dp" android:layout_marginStart="8dp"
                    android:text="➤" android:textSize="20sp"
                    android:background="@drawable/zeno_primary_button" android:textColor="@color/zeno_text"/>
            </LinearLayout>
        </LinearLayout>

        <ScrollView android:id="@+id/appsPage" android:layout_width="match_parent"
            android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingBottom="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Ilovalar" android:textColor="@color/zeno_text" android:textSize="22sp"
                    android:fontFamily="sans-serif-medium" android:paddingTop="8dp"/>
                <EditText android:id="@+id/appSearchInput" android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginTop="12dp" android:hint="⌕   Ilova qidirish..."
                    android:singleLine="true" android:paddingStart="15dp"
                    android:background="@drawable/rounded_input" android:textColor="@color/zeno_text"
                    android:textColorHint="@color/zeno_muted"/>
                <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:columnCount="4" android:useDefaultMargins="true" android:layout_marginTop="16dp">
                    <Button android:id="@+id/appsButton" style="@style/AppTile" android:text="▶&#10;YouTube"/>
                    <Button android:id="@+id/chromeButton" style="@style/AppTile" android:text="🌐&#10;Chrome"/>
                    <Button android:id="@+id/searchButton" style="@style/AppTile" android:text="G&#10;Google"/>
                    <Button android:id="@+id/cameraButton" style="@style/AppTile" android:text="▣&#10;Kamera"/>
                    <Button android:id="@+id/telegramButton" style="@style/AppTile" android:text="➤&#10;Telegram"/>
                    <Button android:id="@+id/instagramButton" style="@style/AppTile" android:text="◎&#10;Instagram"/>
                    <Button android:id="@+id/alarmButton" style="@style/AppTile" android:text="◷&#10;Budilnik"/>
                    <Button android:id="@+id/timerButton" style="@style/AppTile" android:text="◴&#10;Taymer"/>
                </GridLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Tezkor buyruqlar" android:textColor="#F2EDFF" android:textSize="17sp"
                    android:layout_marginTop="18dp" android:fontFamily="sans-serif-medium"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="9dp" android:padding="16dp"
                    android:background="@drawable/zeno_surface"
                    android:text="Telefonni boshqarish  •  Internetdan qidirish  •  Eslatma va budilnik"
                    android:textColor="@color/zeno_muted" android:textSize="13sp"/>
            </LinearLayout>
        </ScrollView>

        <LinearLayout android:id="@+id/voicePage" android:layout_width="match_parent"
            android:layout_height="match_parent" android:visibility="gone"
            android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="VOICE ASSISTANT" android:textColor="@color/zeno_accent"
                android:textSize="11sp" android:letterSpacing="0.22"/>
            <FrameLayout android:layout_width="230dp" android:layout_height="230dp"
                android:layout_marginTop="24dp" android:background="@drawable/zeno_orb">
                <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:text="🎙" android:textSize="62sp"
                    android:textColor="@color/zeno_text"/>
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="25dp" android:text="Hey ZENO"
                android:textColor="#F5F0FF" android:textSize="25sp" android:fontFamily="sans-serif-medium"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="7dp" android:text="Ovozli boshqaruvni yoqing yoki o‘chiring"
                android:textColor="@color/zeno_muted" android:textSize="12sp"/>
            <Button android:id="@+id/listenButton" android:layout_width="match_parent"
                android:layout_height="56dp" android:layout_marginTop="25dp"
                android:background="@drawable/zeno_primary_button"
                android:text="HEY ZENO — YOQISH" android:textAllCaps="false"
                android:textColor="@color/zeno_text" android:textSize="14sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:gravity="center"
                android:text="Mikrofon ishlashi uchun ruxsat talab qilinadi."
                android:textColor="@color/zeno_muted" android:textSize="10sp"/>
        </LinearLayout>

        <ScrollView android:id="@+id/profilePage" android:layout_width="match_parent"
            android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Sozlamalar" android:textColor="@color/zeno_text" android:textSize="22sp"
                    android:fontFamily="sans-serif-medium" android:paddingTop="8dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:padding="18dp"
                    android:background="@drawable/zeno_surface"
                    android:text="ZENO — shaxsiy AI yordamchingiz&#10;&#10;Til: O‘zbek / English&#10;AI Chat: Matnli rejim&#10;Ovoz: Ixtiyoriy&#10;Wake word: Hey ZENO"
                    android:textColor="@color/zeno_text" android:textSize="14sp" android:lineSpacingExtra="7dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:padding="16dp"
                    android:background="@drawable/zeno_surface"
                    android:text="ZENO CORE  •  Personal AI System"
                    android:textColor="@color/zeno_accent_soft" android:textSize="12sp"/>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="62dp"
        android:layout_marginTop="8dp" android:orientation="horizontal"
        android:gravity="center" android:background="@drawable/zeno_nav">
        <Button android:id="@+id/navHome" style="@style/BottomNav" android:text="⌂&#10;Home"/>
        <Button android:id="@+id/navChat" style="@style/BottomNav" android:text="▢&#10;Chat"/>
        <Button android:id="@+id/navApps" style="@style/BottomNav" android:text="▦&#10;Apps"/>
        <Button android:id="@+id/navVoice" style="@style/BottomNav" android:text="🎙&#10;Voice"/>
        <Button android:id="@+id/navProfile" style="@style/BottomNav" android:text="⚙&#10;Settings"/>
    </LinearLayout>
</LinearLayout>